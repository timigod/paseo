#!/bin/zsh
set -eu

task_launcher_path="${0:A}"
task_resources_path="${task_launcher_path:h:h}"

# LaunchAgents must not run an interactive login shell: user shell startup can
# wait on unrelated UI/session state and leave the daemon supervisor alive but
# never started. The daemon only needs the conventional system and Homebrew
# command paths; preserve a caller-provided PATH after those stable entries.
task_system_path="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
if [[ -n "${PATH:-}" ]]; then
  export PATH="${task_system_path}:${PATH}"
else
  export PATH="${task_system_path}"
fi

export ELECTRON_RUN_AS_NODE=1
export PASEO_DESKTOP_MANAGED=1
export PASEO_CLI="$task_resources_path/bin/paseo"
export PASEO_WEB_UI_ENABLED=false

exec "$task_resources_path/../Frameworks/Paseo Helper.app/Contents/MacOS/Paseo Helper" \
  "$task_resources_path/app.asar.unpacked/dist/daemon/node-entrypoint-runner.js" \
  node-script \
  "$task_resources_path/app.asar/node_modules/@getpaseo/server/dist/scripts/supervisor-entrypoint.js"
